  "requirements": [
    [
      "SCI01",
      "Retain 1.000 kg science mass as a user-directed trade assumption",
      "Weigh instrument assembly; record included electronics, reagents and interfaces"
    ],
    [
      "SCI02",
      "Define measured signal, detection limit and abiotic alternatives before instrument freeze",
      "Science review and assay validation with blinded analogs"
    ],
    [
      "SCI03",
      "Separate sample depth from forebody burial depth",
      "Acquisition drawings and sample provenance demonstration"
    ],
    [
      "SCI04",
      "Compare shallow skin with buried sensing without assuming liquid water",
      "Site pressure temperature salt and water-activity model"
    ],
    [
      "SCI05",
      "Allocate blanks, treated controls, reagent controls and replication",
      "Statistical analysis and contamination budget"
    ],
    [
      "SCI06",
      "Define incubation temperature and duration including delayed recovery",
      "Time series analog experiments; no assumed rapid revival"
    ],
    [
      "SYS01",
      "Maintain forebody tether and surface aftbody reference architecture",
      "Interface control drawing and deployment test"
    ],
    [
      "SYS02",
      "Close nominal mass and volume before adding contingency",
      "Measured bill of materials and CAD envelope"
    ],
    [
      "SYS03",
      "Apply 25 percent preliminary mass contingency in this study",
      "Ledger audit; replace with project-approved growth policy later"
    ],
    [
      "MECH01",
      "Verify steel heat treatment toughness and joining at operating temperature",
      "Coupons, NDE, cold impact tests and structural analysis"
    ],
    [
      "MECH02",
      "Keep a physical tether path and release without damaging science hardware",
      "Full-speed deployment and pull tests"
    ],
    [
      "MECH03",
      "Prevent potting from blocking sampling ports and optical or fluid paths",
      "Manufacturing drawing and flow or optical tests"
    ],
    [
      "MECH04",
      "Qualify instrument shock response using local acceleration histories",
      "Instrumented drop tests and post-impact calibration"
    ],
    [
      "PWR01",
      "Close energy for every operating mode with cold aging and conversion losses",
      "Time-resolved power model and battery characterization"
    ],
    [
      "THERM01",
      "Model shell soil sample and electronics as separate thermal nodes",
      "Vacuum cold-chamber correlation and transient thermal analysis"
    ],
    [
      "COM01",
      "Transmit through an exposed antenna via a verified tether interface",
      "Link budget and end-to-end post-impact demonstration"
    ],
    [
      "EDL01",
      "Analyze each delivery scenario with its own entry boundary conditions",
      "Trajectory dispersions and aerodynamic database"
    ],
    [
      "EDL02",
      "Qualify drogue inflation stability and forebody aftbody separation",
      "Mars-relevant deployment tests"
    ],
    [
      "PP01",
      "Obtain applicable planetary-protection classification and endpoints",
      "Mission authority concurrence"
    ],
    [
      "PP02",
      "Validate a compatible reduction process with residues and assay blanks",
      "Microbial reduction and materials compatibility evidence"
    ],
    [
      "PP03",
      "Maintain barriers and cleanliness after treatment",
      "Integration controls and witness monitoring"
    ],
    [
      "VER01",
      "Keep data provenance model version and assumptions with every result",
      "Shared model tests and exported scenario record"
    ]
  ],
